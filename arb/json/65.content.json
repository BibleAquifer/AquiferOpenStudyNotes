"version": "1.0.4",
"title": "يهوذا 1: 18",
"media_type": "Text",
"index_reference": "65001018",
"language": "arb",
"review_level": "None",
"content": "<p><em>إِنَّهُ فِي الزَّمَانِ الأَخِيرِ</em>: مجيء يسوع بصفته المسيا (المختار من الله) يمثل الجزء النهائي من خطة الله. وقد بدأت نبوات العهد القديم المتعلقة بالأيام الأخيرة تتحقق من ذلك الوقت. وبناءً على ذلك، يستند يهوذا إلى نبوة الرسل عن الأزمنة الأخيرة لمعالجة الأزمة الحالية التي تسبب بها المُعَلِّمون الكذبة (<data class=\"bible-ref\" data-start-ref=\"65001019\" data-end-ref=\"65001019\">1:19</data>).</p>",
"associations": {
"passage": [
{
"start_ref": "65001018",
"start_ref_usfm": "JUD 1:18",
"end_ref": "65001018",
"end_ref_usfm": "JUD 1:18"
}
