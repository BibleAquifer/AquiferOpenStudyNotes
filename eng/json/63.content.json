{
"content_id": "14429",
"reference_id": 13597,
"version": "1.0.4",
"title": "2 John 1:8",
"media_type": "Text",
"index_reference": "63001008",
"language": "eng",
"review_level": "Professional",
"content": "<p><em>we</em>: This word refers to the apostles and their co-workers. The apostles taught the truth and defended it against false teachings. Believers, referred to as <em>you</em>, are warned to guard their faith against teachings that could lead them away from God (<data class=\"bible-ref\" data-start-ref=\"63001009\" data-end-ref=\"63001009\">1:9</data>).</p>",
"associations": {
"passage": [
{
"start_ref": "63001008",
"start_ref_usfm": "2JN 1:8",
"end_ref": "63001008",
"end_ref_usfm": "2JN 1:8"
}
],
"resource": [],
"acai": []
}
},
{
