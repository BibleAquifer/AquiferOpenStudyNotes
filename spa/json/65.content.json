"version": "1.0.4",
"title": "Judas 1:22",
"media_type": "Text",
"index_reference": "65001022",
"language": "spa",
"review_level": "None",
"content": "<p>&quot;Y recibid a los unos en piedad, discerniendo&quot;: Algunos creyentes empezaban a cuestionar su fe debido a las afirmaciones de los falsos maestros.</p>",
"associations": {
"passage": [
{
