[
{
"content_id": "14423",
"reference_id": 13591,
"version": "1.0.4",
"title": "2 John 1:1",
"media_type": "Text",
"index_reference": "63001001",
"language": "eng",
"review_level": "Professional",
"content": "<ul><li><p><em>The elder</em>: The apostle John calls himself “the elder” to affirm his authority in the church.</p></li><li><p><em>To the chosen lady</em> <em>and her children</em>: The Greek word <em>kuria</em> could be the name of a specific woman. However, it more likely refers to a local church and its members (see <data class=\"bible-ref\" data-start-ref=\"63001013\" data-end-ref=\"63001013\">1:13</data>).</p></li><li><p><em>whom I love in the truth</em>: This could mean “truly love” (see <data class=\"bible-ref\" data-start-ref=\"63001005\" data-end-ref=\"63001006\">1:5–6</data>). More likely, it refers to the love shared by people who confess the same truth about Christ. This truth stands in contrast to the lies taught by the false teachers (<data class=\"bible-ref\" data-start-ref=\"63001007\" data-end-ref=\"63001007\">1:7</data>; see <data class=\"bible-ref\" data-start-ref=\"62002021\" data-end-ref=\"62002023\">1&nbsp;John 2:21–23</data>). John stresses the pronoun <em>I</em> to emphasize the difference from the false teachers, who lack love and reject the true church.</p></li></ul>",
"associations": {
"passage": [
{
"start_ref": "63001001",
"start_ref_usfm": "2JN 1:1",
"end_ref": "63001001",
"end_ref_usfm": "2JN 1:1"
}
],
