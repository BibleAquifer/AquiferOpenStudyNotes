{
"content_id": "694425",
"reference_id": 18839,
"version": "1.0.4",
"title": "猶大書 1:18",
"media_type": "Text",
"index_reference": "65001018",
"language": "zht",
"review_level": "None",
"content": "<p><em>末世</em>：耶穌作為彌賽亞（神所揀選的那位）降臨，開啟了神的計劃的最後階段。這是舊約聖經中關於末後日子的預言開始成就的時刻。因此，猶大引用使徒的預言來應對由假教師在當時所引發的危機（<data class=\"bible-ref\" data-start-ref=\"65001019\" data-end-ref=\"65001019\">1:19</data>）。</p>",
"associations": {
"passage": [
{
"start_ref": "65001018",
"start_ref_usfm": "JUD 1:18",
"end_ref": "65001018",
"end_ref_usfm": "JUD 1:18"
}
],
"resource": [],
"acai": []
}
